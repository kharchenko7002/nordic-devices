# Nordic Devices AS — environment variables (frontend only)
#
# Copy this file to .env.local and fill in real values to enable EmailJS.
# When any of the three values is missing, the order confirmation flow falls
# back to a mailto: link that opens the user's e-mail client with a
# ready-made message. NEVER commit real keys to the repository.
#
# In production a backend API is preferred — the browser is not the right
# place to keep service credentials.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
