# Nordic Devices AS — backend e-post-konfigurasjon
#
# Kopier denne filen til backend/.env og fyll inn ekte verdier.
# Hvis SMTP_HOST/USER/PASS ikke er satt, brukes Ethereal (test inbox).
# Da skrives en preview-URL til logg i stedet for å sende ekte e-post.

# === Gmail (App Password) ===
# 1. Slå på 2FA på Google-kontoen: https://myaccount.google.com/security
# 2. Lag et App Password: https://myaccount.google.com/apppasswords
# 3. Lim inn passordet (16 tegn, uten mellomrom) i SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=din.adresse@gmail.com
SMTP_PASS=app-password-her

# Avsenderadresse (vises i e-posten). Default = SMTP_USER.
SMTP_FROM="Nordic Devices AS <din.adresse@gmail.com>"

# Valgfri BCC — får kopi av hver bestilling (f.eks. salg@nordicdevices.no).
CONFIRMATION_BCC=

# === Server ===
PORT=4000
TRUST_PROXY=true

# === Rate limit ===
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
